@model List<CharacterBuilderApp.Models.Character>

<h1>Character List</h1>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Class</th>
            <th>Level</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var character in Model)
        {
            <tr>
                <td>@character.Name</td>
                <td>@character.Class</td>
                <td>@character.Level</td>
                <td>
                    <a asp-action="Details" asp-route-id="@character.Id" class="btn btn-info">View Details</a>
                    <a asp-action="Edit" asp-route-id="@character.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@character.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Create New Character</a>
